parameters:
    level: 5

    paths:
        - api/controllers
        - api/models
        - merchant/controllers
        - merchant/models
        - admin/controllers
        - admin/models
        - common/base
        - common/behaviors
        - common/enums
        - common/exceptions
        - common/models
        - common/services
        - console/controllers
        - console/migrations

    scanDirectories:
        - common/tests/Support

    bootstrapFiles:
        - phpstan-bootstrap.php

    dynamicConstantNames:
        - YII_DEBUG
        - YII_ENV
        - YII_ENV_DEV
        - YII_ENV_PROD
        - YII_ENV_TEST

    tmpDir: %currentWorkingDirectory%/runtime
